# Cashfree Payment Gateway — Sandbox Credentials
# Replace MY_TEST_APP_ID and MY_TEST_SECRET_KEY with your actual Cashfree Sandbox credentials.
# Get them from: https://merchant.cashfree.com → Developers → API Keys

CASHFREE_APP_ID=MY_TEST_APP_ID
CASHFREE_SECRET_KEY=MY_TEST_SECRET_KEY
CASHFREE_ENVIRONMENT=sandbox

# Backend server port
PORT=3001
