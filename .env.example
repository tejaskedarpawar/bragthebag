# ─── Cashfree Payment Gateway Credentials ──────────────────────────────
# In local development: place these in your root .env file.
# On Vercel: add these in Project Settings → Environment Variables.
#
# Get your API keys from: https://merchant.cashfree.com → Developers → API Keys

# Cashfree App ID (Client ID)
CASHFREE_APP_ID=TEST11198077cba3313508010de635b777089111

# Cashfree Secret Key (Client Secret)
CASHFREE_SECRET_KEY=cfsk_ma_test_7e01b214972aa4d7e51057b75e4188e7_afd58a63

# Cashfree Environment: 'sandbox' (testing) or 'production' (live)
CASHFREE_ENVIRONMENT=sandbox

# Frontend Cashfree SDK Mode: 'sandbox' or 'production'
VITE_CASHFREE_MODE=sandbox

# Backend Port (local development server)
PORT=3001
